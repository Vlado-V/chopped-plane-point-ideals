module

public import Mathlib

@[expose] public section

/-!
# The presentation reduction for a chopped ideal

If `φ : V × W → M` presents a module with relations `A : E → V × W`,
then killing the generators in `V` leaves precisely the cokernel of the
`W`-component of `A`. This is the degreewise linear algebra behind equation
(4.5). Exactness is stated explicitly, so this lemma applies to an actual
presentation, without assuming the desired dimension of the quotient.
-/
namespace ChoppedPlane

section Presentation

variable {K E V W M : Type*} [Field K]
  [AddCommGroup E] [Module K E]
  [AddCommGroup V] [Module K V]
  [AddCommGroup W] [Module K W]
  [AddCommGroup M] [Module K M]

/-- The submodule generated by the first group of generators. -/
def choppedSubmodule (φ : V × W →ₗ[K] M) : Submodule K M :=
  LinearMap.range (φ.comp (LinearMap.inl K V W))

/-- The remaining generators map to the quotient by the chopped generators. -/
def residualMap (φ : V × W →ₗ[K] M) :
    W →ₗ[K] M ⧸ choppedSubmodule φ :=
  (choppedSubmodule φ).mkQ.comp (φ.comp (LinearMap.inr K V W))

/-- The relations among the remaining generators are exactly the projected
original relations. -/
theorem ker_residualMap (A : E →ₗ[K] V × W) (φ : V × W →ₗ[K] M)
    (hexact : LinearMap.ker φ = LinearMap.range A) :
    LinearMap.ker (residualMap φ) =
      LinearMap.range ((LinearMap.snd K V W).comp A) := by
  ext w
  constructor
  · intro hw
    have hw' : φ (0, w) ∈ choppedSubmodule φ := by
      simpa [LinearMap.mem_ker, residualMap] using hw
    rcases hw' with ⟨v, hv⟩
    have hker : (-v, w) ∈ LinearMap.ker φ := by
      rw [LinearMap.mem_ker]
      have hdecomp : (-v, w) = (0, w) - (v, 0) := by simp
      rw [hdecomp, map_sub]
      exact sub_eq_zero.mpr hv.symm
    rw [hexact] at hker
    rcases hker with ⟨e, he⟩
    exact ⟨e, by simpa using congrArg Prod.snd he⟩
  · rintro ⟨e, he⟩
    have hAe : φ (A e) = 0 := by
      have : A e ∈ LinearMap.range A := ⟨e, rfl⟩
      rw [← hexact, LinearMap.mem_ker] at this
      exact this
    have hdecomp : (0, w) = A e - ((A e).1, 0) := by
      ext <;> simp_all
    have hw' : φ (0, w) ∈ choppedSubmodule φ := by
      refine ⟨-(A e).1, ?_⟩
      simp only [LinearMap.comp_apply, LinearMap.inl_apply]
      rw [hdecomp, map_sub, hAe, zero_sub]
      have : (-(A e).1, (0 : W)) = -((A e).1, (0 : W)) := by simp
      rw [this, map_neg]
    simpa [LinearMap.mem_ker, residualMap] using hw'

/-- Surjectivity of a presentation is preserved after removing the chopped
summand of generators. -/
theorem residualMap_surjective (φ : V × W →ₗ[K] M)
    (hsurj : Function.Surjective φ) : Function.Surjective (residualMap φ) := by
  intro q
  induction q using Submodule.Quotient.induction_on with
  | _ m =>
    rcases hsurj m with ⟨⟨v, w⟩, rfl⟩
    refine ⟨w, ?_⟩
    change (Submodule.Quotient.mk (φ (0, w)) : M ⧸ choppedSubmodule φ) =
      Submodule.Quotient.mk (φ (v, w))
    apply (Submodule.Quotient.eq _).mpr
    have hdecomp : φ (0, w) - φ (v, w) = φ (-v, 0) := by
      rw [← map_sub]
      congr 1
      ext <;> simp
    rw [hdecomp]
    exact ⟨-v, rfl⟩

/-- The quotient by the chopped generators is the cokernel of the projected
relations. This equivalence is the algebraic content of equation (4.5). -/
noncomputable def choppedQuotientEquiv (A : E →ₗ[K] V × W)
    (φ : V × W →ₗ[K] M) (hsurj : Function.Surjective φ)
    (hexact : LinearMap.ker φ = LinearMap.range A) :
    (M ⧸ choppedSubmodule φ) ≃ₗ[K]
      (W ⧸ LinearMap.range ((LinearMap.snd K V W).comp A)) :=
  ((Submodule.quotEquivOfEq _ _ (ker_residualMap A φ hexact).symm).trans
    ((residualMap φ).quotKerEquivOfSurjective
      (residualMap_surjective φ hsurj))).symm

/-- The equivalence carries each remaining generator to its cokernel class. -/
@[simp] theorem choppedQuotientEquiv_residualMap (A : E →ₗ[K] V × W)
    (φ : V × W →ₗ[K] M) (hsurj : Function.Surjective φ)
    (hexact : LinearMap.ker φ = LinearMap.range A) (w : W) :
    choppedQuotientEquiv A φ hsurj hexact (residualMap φ w) =
      Submodule.Quotient.mk w := by
  apply (choppedQuotientEquiv A φ hsurj hexact).symm.injective
  simp [choppedQuotientEquiv]

/-- An exact presentation gives the quotient dimension by subtracting the rank
of its projected relation matrix. -/
theorem finrank_choppedQuotient [FiniteDimensional K W]
    (A : E →ₗ[K] V × W) (φ : V × W →ₗ[K] M)
    (hsurj : Function.Surjective φ)
    (hexact : LinearMap.ker φ = LinearMap.range A) :
    Module.finrank K (M ⧸ choppedSubmodule φ) =
      Module.finrank K W -
        Module.finrank K (LinearMap.range ((LinearMap.snd K V W).comp A)) := by
  rw [(choppedQuotientEquiv A φ hsurj hexact).finrank_eq]
  exact Submodule.finrank_quotient _

/-- Maximal rank of the projected relations yields the positive-part formula
in natural-number subtraction. -/
theorem finrank_choppedQuotient_of_maximalRank
    [FiniteDimensional K E] [FiniteDimensional K W]
    (A : E →ₗ[K] V × W) (φ : V × W →ₗ[K] M)
    (hsurj : Function.Surjective φ)
    (hexact : LinearMap.ker φ = LinearMap.range A)
    (hmax : Module.finrank K (LinearMap.range ((LinearMap.snd K V W).comp A)) =
      min (Module.finrank K E) (Module.finrank K W)) :
    Module.finrank K (M ⧸ choppedSubmodule φ) =
      Module.finrank K W - Module.finrank K E := by
  rw [finrank_choppedQuotient A φ hsurj hexact, hmax]
  omega

end Presentation

end ChoppedPlane
