module

public import Mathlib

@[expose] public section

/-! Independent statements of Theorem 1.1 and Corollary 5.1. This file imports only Mathlib.
Points `(a,b)` stand for `[a:b:1]`; the ideals and quotient spaces below are
actual ideals and vector spaces in the ternary polynomial ring. -/

noncomputable section
namespace ChoppedPlanePaper
open MvPolynomial Module

/-- The polynomial ring in `n` variables over `K`. -/
abbrev Poly (K : Type*) [Field K] (n : ℕ) := MvPolynomial (Fin n) K

/-- Homogeneous polynomials of total degree `d`. -/
abbrev Forms (K : Type*) [Field K] (n d : ℕ) :=
  MvPolynomial.homogeneousSubmodule (Fin n) K d

variable (K : Type*) [Field K]

/-- Ordered coordinates of `p` points in the projective chart `z ≠ 0`. -/
abbrev PointCoordinates (p : ℕ) := Fin p × Fin 2 → K

/-- Normalized projective coordinates of one point. -/
def chartPoint {p : ℕ} (a : PointCoordinates K p) (i : Fin p) : Fin 3 → K :=
  ![a (i, 0), a (i, 1), 1]

/-- The normalized projective points are pairwise distinct. -/
def DistinctPoints {p : ℕ} (a : PointCoordinates K p) : Prop :=
  Function.Injective (fun i => (a (i, 0), a (i, 1)))

/-- The homogeneous ideal `⟨x-a*z, y-b*z⟩` of `[a:b:1]`. -/
def singlePointIdeal (a b : K) : Ideal (Poly K 3) :=
  Ideal.span {X 0 - C a * X 2, X 1 - C b * X 2}

/-- The vanishing ideal is the intersection of the individual point ideals. -/
def pointIdeal {p : ℕ} (a : PointCoordinates K p) : Ideal (Poly K 3) :=
  ⨅ i : Fin p, singlePointIdeal K (a (i, 0)) (a (i, 1))

/-- Evaluation of homogeneous forms at one normalized point. -/
def evaluationLinear (n d : ℕ) (x : Fin n → K) : Forms K n d →ₗ[K] K where
  toFun f := MvPolynomial.eval x f.val
  map_add' f g := map_add _ _ _
  map_smul' c f := by simp

/-- Evaluation of a degree-`d` form at every point. -/
def pointEvaluation {p : ℕ} (a : PointCoordinates K p) (d : ℕ) :
    Forms K 3 d →ₗ[K] (Fin p → K) :=
  LinearMap.pi (fun i => evaluationLinear K 3 d (chartPoint K a i))

/-- The degree-`d` homogeneous equations vanishing at every point. -/
def pointDegreePiece {p : ℕ} (a : PointCoordinates K p) (d : ℕ) :
    Submodule K (Forms K 3 d) := LinearMap.ker (pointEvaluation K a d)

/-- The same degree-`d` equations as a subspace of the polynomial ring. -/
def pointDegreeSpace {p : ℕ} (a : PointCoordinates K p) (d : ℕ) :
    Submodule K (Poly K 3) :=
  (pointDegreePiece K a d).map (Forms K 3 d).subtype

/-- The ideal generated by all the degree-`d` equations. -/
def choppedIdeal {p : ℕ} (a : PointCoordinates K p) (d : ℕ) : Ideal (Poly K 3) :=
  Ideal.span (pointDegreeSpace K a d : Set (Poly K 3))

/-- Dimension of the degree-`d` point quotient. The proof development proves
that the evaluation kernel is exactly the homogeneous point-ideal piece. -/
def pointHilbertFunction {p : ℕ} (a : PointCoordinates K p) (d : ℕ) : ℕ :=
  finrank K ((Forms K 3 d) ⧸ pointDegreePiece K a d)

variable {K}

/-- Map from homogeneous forms to the actual quotient by the generated ideal. -/
def formToRingQuotient {n : ℕ} (j : ℕ) (W : Submodule K (Poly K n)) :
    Forms K n j →ₗ[K] Poly K n ⧸ Ideal.span (W : Set (Poly K n)) :=
  (Ideal.Quotient.mkₐ K (Ideal.span (W : Set (Poly K n)))).toLinearMap.comp
    (Forms K n j).subtype

/-- Dimension of the homogeneous image in the actual generated-ideal quotient. -/
def generatedHilbertFunction {n : ℕ} (W : Submodule K (Poly K n)) (j : ℕ) : ℕ :=
  Module.finrank K (LinearMap.range (formToRingQuotient j W))

/-- Hilbert function of the actual quotient by the degree chop. -/
def choppedHilbertFunction {p : ℕ} (a : PointCoordinates K p) (d t : ℕ) : ℕ :=
  generatedHilbertFunction (pointDegreeSpace K a d) t

/-- Dimension of degree-`t` ternary forms. -/
def N (t : ℕ) : ℕ := (t + 2).choose 2

/-- Extend the ternary-form dimension by zero to negative degrees. -/
def N₂ (t : ℤ) : ℤ := if 0 ≤ t then (N t.toNat : ℤ) else 0

/-- Rational zero of the residual dimension's decreasing linear factor. -/
def residualThreshold (d r : ℕ) : ℚ :=
  (2 * (d : ℚ) + 3 - 3 * (r : ℚ)) / ((r : ℚ) - 1)

/-- Least positive excess degree at which the chopped ideal fills the point ideal. -/
def cutoff (d r : ℕ) : ℕ := max 1 ⌈residualThreshold d r⌉₊

/-- Hilbert coefficient of a regular sequence of length one or two. -/
def completeIntersectionCoefficient (d r t : ℕ) : ℤ :=
  N₂ t - (r : ℤ) * N₂ ((t : ℤ) - d) +
    (r.choose 2 : ℤ) * N₂ ((t : ℤ) - 2 * d)

/-- The complete piecewise Hilbert function from Theorem 1.1. -/
def expectedChoppedHilbertFunction (d p t : ℕ) : ℕ :=
  if t < d then N t
  else if N d ≤ p then N t
  else if p ≤ N (d - 1) then p
  else let r := N d - p
    if r ≤ 2 then (completeIntersectionCoefficient d r t).toNat
    else max p (N t - r * N (t - d))

variable (K)

/-- Equality of the homogeneous pieces in the actual two ideals. -/
def ChopEqualsPointPiece {p : ℕ} (a : PointCoordinates K p) (d t : ℕ) : Prop :=
  ∀ f : Forms K 3 t, f.val ∈ choppedIdeal K a d ↔ f.val ∈ pointIdeal K a

/-- The chop is generated by a genuine regular sequence of length `r`. -/
def ChopHasRegularGenerators {p : ℕ} (a : PointCoordinates K p) (d r : ℕ) : Prop :=
  ∃ f : Fin r → Forms K 3 d,
    Ideal.span (Set.range (fun i => (f i).val)) = choppedIdeal K a d ∧
    RingTheory.Sequence.IsRegular (Poly K 3) (List.ofFn (fun i => (f i).val))

/-- Every conclusion of Theorem 1.1, including the ideal assertions and cutoff. -/
def MainConclusion {p : ℕ} (a : PointCoordinates K p) (d : ℕ) : Prop :=
  DistinctPoints K a ∧
  (∀ t, pointHilbertFunction K a t = min (N t) p) ∧
  (∀ t, choppedHilbertFunction a d t = expectedChoppedHilbertFunction d p t) ∧
  (N d ≤ p → choppedIdeal K a d = ⊥) ∧
  (p ≤ N (d - 1) → ∀ t, d ≤ t → ChopEqualsPointPiece K a d t) ∧
  (N (d - 1) < p → p < N d →
    let r := N d - p
    (r ≤ 2 → ChopHasRegularGenerators K a d r) ∧
    (3 ≤ r →
      cutoff d r < d ∧
      ∀ e, 1 ≤ e → (ChopEqualsPointPiece K a d (d + e) ↔ cutoff d r ≤ e)))

/-- One nonempty principal open in the actual configuration space gives every
assertion in every degree simultaneously. -/
def GenericChoppedConclusion (d p : ℕ) : Prop :=
  ∃ D : MvPolynomial (Fin p × Fin 2) K,
    (∃ a, eval a D ≠ 0) ∧
    ∀ a, eval a D ≠ 0 → MainConclusion K a d

/-- The full theorem uniformly over characteristic-zero fields, `d ≥ 2`, and
positive point counts. No generic-position or geometric assertion is a premise. -/
def Statement : Prop :=
  ∀ (K : Type) [Field K] [CharZero K],
    ∀ d p : ℕ, 2 ≤ d → 1 ≤ p → GenericChoppedConclusion K d p


/-- The coefficient of the complete Koszul series `(1-z^d)^r/(1-z)^3`. -/
def koszulCoefficient (d r t : ℕ) : ℤ :=
  ∑ k ∈ Finset.range (r + 1),
    (-1 : ℤ)^k * (r.choose k : ℤ) * N₂ ((t : ℤ) - (k : ℤ) * d)

/-- A hit in a positive excess degree, remembered in every later degree.
Equality in the generating degree does not trigger truncation. -/
def koszulPrefixHit (d p e : ℕ) : Prop :=
  ∃ q : ℕ, 1 ≤ q ∧ q ≤ e ∧ koszulCoefficient d (N d - p) (d + q) ≤ p

/-- The exact GKT positive-prefix truncation: retain the complete Koszul
coefficient until a positive hit, then retain the point count. If there is no
hit, the untruncated coefficient is retained in every degree. -/
def expectedSyzygyCoefficient (d p t : ℕ) : ℤ := by
  classical
  exact if t < d then N t
    else if koszulPrefixHit d p (t - d) then p
    else koszulCoefficient d (N d - p) t

/-- The conjecture chops in the least degree whose form dimension reaches
its point count. Existence uses only the elementary binomial recurrence. -/
def expectedSyzygyDegree (p : ℕ) : ℕ :=
  Nat.find (show ∃ d, p ≤ N d from ⟨p,
    Nat.le_trans (Nat.le_succ p)
      (Eq.mpr
        (congrArg (fun n : ℕ => p + 1 ≤ n)
          ((Nat.choose_succ_succ (p + 1) 1).trans
            (congrArg (fun n => n + (p + 1).choose 2) (Nat.choose_one_right (p + 1)))))
        (Nat.le_add_right (p + 1) ((p + 1).choose 2)))⟩)

/-- The minimal-degree convention for the Expected Syzygy Conjecture. -/
def IsExpectedSyzygyDegree (d p : ℕ) : Prop :=
  p ≤ N d ∧ ∀ t, t < d → N t < p

variable {K}

/-- The actual quotient by the chop has the independently specified Koszul
coefficients in every degree, at the conjecture's minimal generating degree. -/
def ExpectedSyzygyConclusion {p : ℕ} (a : PointCoordinates K p) (d : ℕ) : Prop :=
  IsExpectedSyzygyDegree d p ∧ DistinctPoints K a ∧
  (∀ t, pointHilbertFunction K a t = min (N t) p) ∧
  ∀ t, (choppedHilbertFunction a d t : ℤ) = expectedSyzygyCoefficient d p t

/-- One nonempty polynomial open supplies Corollary 5.1 in all degrees. -/
def GenericExpectedSyzygyConclusion (K : Type*) [Field K] (p : ℕ) : Prop :=
  ∃ D : MvPolynomial (Fin p × Fin 2) K,
    (∃ a, MvPolynomial.eval a D ≠ 0) ∧
    ∀ a, MvPolynomial.eval a D ≠ 0 →
      ExpectedSyzygyConclusion (K := K) a (expectedSyzygyDegree p)

/-- The positive Koszul modules' alternating contribution to the ideal piece,
with the literal indexing of GKT Conjecture 1. -/
def koszulIdealCoefficient (d r t : ℕ) : ℤ :=
  ∑ k ∈ Finset.range r,
    (-1 : ℤ)^(k + 2) * (r.choose (k + 1) : ℤ) *
      N₂ ((t : ℤ) - ((k + 1 : ℕ) : ℤ) * d)

/-- The expected dimension of the degree-`d+e` homogeneous ideal piece. -/
def expectedSyzygyIdealCoefficient (d p e : ℕ) : ℤ := by
  classical
  exact if koszulPrefixHit d p e then (N (d + e) : ℤ) - p
    else koszulIdealCoefficient d (N d - p) (d + e)

/-- Corollary 5.1 uniformly over characteristic-zero fields and every point
count. The degree-zero, degree-one, and empty cases are included. -/
def ExpectedSyzygyStatement : Prop :=
  ∀ (K : Type) [Field K] [CharZero K],
    ∀ p : ℕ, GenericExpectedSyzygyConclusion K p

end ChoppedPlanePaper
