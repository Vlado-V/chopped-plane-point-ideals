module

public import ChoppedPlane.ChoppedFunctions
public import ChoppedPlane.Numerics
public import Mathlib.RingTheory.Regular.RegularSequence
public import Mathlib.Algebra.CharZero.Infinite

@[expose] public section

/-! A specification of Theorem 1.1 using actual projective chart point ideals.
A single nonempty principal open must supply every degree simultaneously. -/
noncomputable section
namespace ChoppedPlane
open MvPolynomial

/-- The Hilbert-function coefficients for a regular sequence of one or two
forms, including all terms of the Koszul numerator. -/
def completeIntersectionCoefficient (d r t : ℕ) : ℤ :=
  N₂ t - (r : ℤ) * N₂ ((t : ℤ) - d) +
    (r.choose 2 : ℤ) * N₂ ((t : ℤ) - 2 * d)

/-- The piecewise Hilbert function asserted by Theorem 1.1. -/
def expectedChoppedHilbertFunction (d p t : ℕ) : ℕ :=
  if t < d then N t
  else if N d ≤ p then N t
  else if p ≤ N (d - 1) then p
  else let r := N d - p
    if r ≤ 2 then (completeIntersectionCoefficient d r t).toNat
    else max p (N t - r * N (t - d))

variable (K : Type*) [Field K]

/-- Equality of the homogeneous pieces in the genuine two ideals. -/
def ChopEqualsPointPiece {p : ℕ} (a : PointCoordinates K p) (d t : ℕ) : Prop :=
  ∀ f : Forms K 3 t, f.val ∈ choppedIdeal K a d ↔ f.val ∈ pointIdeal K a

/-- The chop is generated by a regular sequence of the stated length. -/
def ChopHasRegularGenerators {p : ℕ} (a : PointCoordinates K p) (d r : ℕ) : Prop :=
  ∃ f : Fin r → Forms K 3 d,
    Ideal.span (Set.range (fun i => (f i).val)) = choppedIdeal K a d ∧
    RingTheory.Sequence.IsRegular (Poly K 3) (List.ofFn (fun i => (f i).val))

/-- All conclusions of the theorem, including the ideal equalities and the
least positive cutoff. The small-generator assertion is a genuine regular
sequence assertion, not just a matching numerical series. -/
def MainConclusion {p : ℕ} (a : PointCoordinates K p) (d : ℕ) : Prop :=
  DistinctPoints K a ∧
  (∀ t, pointHilbertFunction K a t = min (N t) p) ∧
  (∀ t, choppedHilbertFunction a d t = expectedChoppedHilbertFunction d p t) ∧
  (N d ≤ p → choppedIdeal K a d = ⊥) ∧
  (p ≤ N (d - 1) → ∀ t, d ≤ t → ChopEqualsPointPiece K a d t) ∧
  (N (d - 1) < p → p < N d →
    let r := N d - p
    (r ≤ 2 → ChopHasRegularGenerators K a d r) ∧
    (3 ≤ r →
      cutoff d r < d ∧
      ∀ e, 1 ≤ e → (ChopEqualsPointPiece K a d (d + e) ↔ cutoff d r ≤ e)))

/-- Generality means one nonempty polynomial open in the ordered chart
configuration space; it is not an assumption that the conclusion holds. -/
def GenericChoppedConclusion (d p : ℕ) : Prop :=
  ∃ D : MvPolynomial (Fin p × Fin 2) K,
    (∃ a, eval a D ≠ 0) ∧
    ∀ a, eval a D ≠ 0 → MainConclusion K a d

/-- The complete main theorem, uniformly over characteristic-zero fields.
The remaining proof must construct the open polynomial; no geometric input
is assumed in this specification. -/
def MainStatement : Prop :=
  ∀ (K : Type) [Field K] [CharZero K],
    ∀ d p : ℕ, 2 ≤ d → 1 ≤ p → GenericChoppedConclusion K d p

end ChoppedPlane
